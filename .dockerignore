# Git
.git
.gitignore

# Build outputs
**/bin/
**/obj/
**/node_modules/
**/dist/

# Host-built SDK artifacts (packed .nupkg/.tgz). These are produced FRESH
# inside the image during the *-test stages, so the host copies must NOT be
# sent in the build context -- that would risk baking a stale artifact.
artifacts/

# Test outputs
**/TestResults/
**/coverage/

# IDE
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Documentation
docs/
*.md
!README.md

# Other
*.log
*.tmp


# higekato agent scratchpad
higekato-note.md

# Local secrets (never sent to the build context; config.local.json.example
# is a placeholder-only template and intentionally still ships)
config.local.json
*.local.json
.env*
