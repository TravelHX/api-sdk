<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Deterministic resolution: drop any inherited sources, then add only
         the local artifact feed and nuget.org (for transitive deps). -->
    <clear />
    <add key="local-artifacts" value="../../artifacts/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
